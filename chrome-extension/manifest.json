{
  "manifest_version": 3,
  "name": "Transcribe",
  "version": "2.0.0",
  "description": "Transcribe audio and video files with OpenAI Whisper",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://api.openai.com/*", "https://api.scribetok.com/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
